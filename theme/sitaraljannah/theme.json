{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base", "name": "Ivory", "color": "#FAF6EF" },
				{ "slug": "base-2", "name": "Sand", "color": "#F1E9DC" },
				{ "slug": "contrast", "name": "Ink", "color": "#1E2622" },
				{ "slug": "contrast-2", "name": "Stone", "color": "#5C645F" },
				{ "slug": "primary", "name": "Emerald", "color": "#14463A" },
				{ "slug": "primary-2", "name": "Deep Emerald", "color": "#0C2E26" },
				{ "slug": "accent", "name": "Gold", "color": "#B48A4A" },
				{ "slug": "accent-2", "name": "Soft Gold", "color": "#E6D3AE" },
				{ "slug": "border", "name": "Hairline", "color": "#E2D8C7" }
			],
			"gradients": [
				{
					"slug": "veil",
					"name": "Veil",
					"gradient": "linear-gradient(180deg, rgba(12,46,38,0) 0%, rgba(12,46,38,0.78) 100%)"
				},
				{
					"slug": "dawn",
					"name": "Dawn",
					"gradient": "linear-gradient(160deg, #F1E9DC 0%, #FAF6EF 60%)"
				}
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1280px"
		},
		"spacing": {
			"units": [ "px", "rem", "em", "%", "vh", "vw" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "2X-Small", "size": "0.5rem" },
				{ "slug": "30", "name": "X-Small", "size": "1rem" },
				{ "slug": "40", "name": "Small", "size": "clamp(1.25rem, 2vw, 1.5rem)" },
				{ "slug": "50", "name": "Medium", "size": "clamp(1.75rem, 3vw, 2.5rem)" },
				{ "slug": "60", "name": "Large", "size": "clamp(2.5rem, 5vw, 4rem)" },
				{ "slug": "70", "name": "X-Large", "size": "clamp(3.5rem, 8vw, 6.5rem)" },
				{ "slug": "80", "name": "2X-Large", "size": "clamp(5rem, 11vw, 9rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontSizes": [
				{ "slug": "x-small", "name": "Extra small", "size": "0.75rem", "fluid": false },
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.375rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "2rem", "fluid": { "min": "1.625rem", "max": "2.25rem" } },
				{ "slug": "xx-large", "name": "2X large", "size": "3rem", "fluid": { "min": "2.25rem", "max": "3.5rem" } },
				{ "slug": "display", "name": "Display", "size": "4.5rem", "fluid": { "min": "2.75rem", "max": "5.5rem" } }
			],
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Jost",
					"fontFamily": "Jost, \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Jost",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/jost-latin-wght-normal.woff2" ]
						}
					]
				},
				{
					"slug": "heading",
					"name": "Cormorant Garamond",
					"fontFamily": "\"Cormorant Garamond\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Cormorant Garamond",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/cormorant-garamond-latin-wght-normal.woff2" ]
						},
						{
							"fontFamily": "Cormorant Garamond",
							"fontStyle": "italic",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/cormorant-garamond-latin-wght-italic.woff2" ]
						}
					]
				},
				{
					"slug": "arabic",
					"name": "Amiri",
					"fontFamily": "Amiri, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Amiri",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/amiri-arabic-400-normal.woff2" ]
						}
					]
				}
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "soft", "name": "Soft", "shadow": "0 18px 40px -24px rgba(12,46,38,0.35)" }
			]
		},
		"blocks": {
			"core/button": {
				"border": { "radius": false }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"lineHeight": "1.7"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "500",
					"lineHeight": "1.15",
					"letterSpacing": "-0.01em"
				},
				"color": { "text": "var(--wp--preset--color--primary-2)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--display)", "fontWeight": "400" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "fontWeight": "400" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h5": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontFamily": "var(--wp--preset--font-family--body)", "textTransform": "uppercase", "letterSpacing": "0.14em" } },
			"h6": { "typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontFamily": "var(--wp--preset--font-family--body)", "textTransform": "uppercase", "letterSpacing": "0.14em" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": { "radius": "0", "width": "1px", "style": "solid", "color": "var(--wp--preset--color--primary)" },
				"spacing": { "padding": { "top": "0.95em", "bottom": "0.95em", "left": "2.2em", "right": "2.2em" } },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "500",
					"letterSpacing": "0.16em",
					"textTransform": "uppercase"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-2)",
						"text": "var(--wp--preset--color--base)"
					},
					"border": { "color": "var(--wp--preset--color--primary-2)" }
				},
				":focus": {
					"outline": { "color": "var(--wp--preset--color--accent)", "offset": "3px", "style": "solid", "width": "2px" }
				}
			},
			"caption": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" },
				"color": { "text": "var(--wp--preset--color--contrast-2)" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "500",
					"letterSpacing": "0.04em"
				},
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--primary-2)" },
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"letterSpacing": "0.12em",
					"textTransform": "uppercase"
				},
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						":hover": { "typography": { "textDecoration": "underline" } }
					}
				}
			},
			"core/quote": {
				"border": { "width": "0" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontStyle": "italic",
					"lineHeight": "1.35"
				}
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--border)" }
			},
			"core/post-title": {
				"elements": {
					"link": { "typography": { "textDecoration": "none" }, "color": { "text": "inherit" } }
				}
			},
			"core/post-date": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" },
				"color": { "text": "var(--wp--preset--color--contrast-2)" }
			},
			"core/image": {
				"border": { "radius": "0" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-full-width", "title": "Full width (no title)", "postTypes": [ "page" ] }
	]
}
